import RHLean.Geometry.NativeTwistedTraceDescent

/-!
# Regularity on the actual graded section algebra

Source: `CocoSgt/riemann-hypothesis-lean` at
`7cbf7a0c32fca1badf05931879a37c3f8a2b03b4`,
`Development/AbelianVarietyTheory/Proofs/DivisorProofs/IntegerExponentSectionMulEqZeroImpEqZero.lean`
and the section-algebra construction in
`Development/AbelianVarietyTheory/Definitions/Divisors/MemLevEigenIffTransl.lean`.

The original regular determinant is regular on the algebra generated by
integer-exponent sections. It need not be regular in the whole ambient ring
of rules on arbitrary test rings. This file reconstructs that precise
supplier: the section algebra is constructed from its weight spaces;
finite sums of weights are separated by the explicit, distinct torus
characters; generic-frame faithfulness then proves regularity on that
section algebra.

No reducedness assumption on the ambient ring and no enumeration of its
minimal primes is introduced. The geometric facts that remain to attach
are the actual generic-frame evaluations, their weight law, and their
faithfulness on each homogeneous section space. These are `genVal`,
`evR_frBor`, and `secZ_eq_zero_of_genVal` in the pinned source.
-/

set_option autoImplicit false
set_option maxHeartbeats 4000000

noncomputable section
open scoped BigOperators

namespace RHLean.Geometry

/-- The original integer-weight torus character, with no normalization. -/
def nativeWeightTorusCharacter {I : Type} [Fintype I]
    (F : Type) [Field F] (d : I → ℤ) : (I → Fˣ) →* F where
  toFun t := ((∏ i, t i ^ d i : Fˣ) : F)
  map_one' := by simp
  map_mul' t s := by simp [mul_zpow, Finset.prod_mul_distrib]

/-- Distinct integer weights give distinct characters. The proof uses the
actual torus point with one coordinate equal to 2, as in the source. -/
theorem nativeWeightTorusCharacter_injective
    {I : Type} [Fintype I] [DecidableEq I]
    (F : Type) [Field F] [CharZero F] :
    Function.Injective (nativeWeightTorusCharacter (I := I) F) := by
  intro d d' hdd
  funext i
  let u : Fˣ := Units.mk0 2 two_ne_zero
  have hp : ∀ w : I → ℤ,
      nativeWeightTorusCharacter F w (Pi.mulSingle i u) = (2 : F) ^ w i := by
    intro w
    change ((∏ j, (Pi.mulSingle i u : I → Fˣ) j ^ w j : Fˣ) : F) = _
    rw [Finset.prod_eq_single i]
    · simp [u, Units.val_zpow_eq_zpow_val]
    · intro j _ hj
      simp [Pi.mulSingle_eq_of_ne hj]
    · simp
  have h1 : (2 : F) ^ d i = (2 : F) ^ d' i := by
    rw [← hp, ← hp, hdd]
  have h2 : (((2 : ℚ) ^ d i : ℚ) : F) = (((2 : ℚ) ^ d' i : ℚ) : F) := by
    rw [Rat.cast_zpow, Rat.cast_zpow, Rat.cast_ofNat]
    exact h1
  exact zpow_right_injective₀ (by norm_num : (0 : ℚ) < 2) (by norm_num)
    (Rat.cast_injective h2)

/-- Construct the section algebra from the actual integer-weight spaces. -/
def nativeGradedSectionAlgebra
    {I K R : Type} [Field K] [CommRing R] [Algebra K R]
    (W : (I → ℤ) → Submodule K R)
    (hone : (1 : R) ∈ W 0)
    (hprod : ∀ e e', W e * W e' ≤ W (e + e')) : Subalgebra K R :=
  (⨆ e, W e).toSubalgebra (Submodule.mem_iSup_of_mem 0 hone) fun x y hx hy => by
    have h : (⨆ e, W e) * (⨆ e, W e) ≤ ⨆ e, W e := by
      rw [Submodule.iSup_mul]
      refine iSup_le fun e => ?_
      rw [Submodule.mul_iSup]
      exact iSup_le fun e' => (hprod e e').trans (le_iSup W (e + e'))
    exact h (Submodule.mul_mem_mul hx hy)

/-- Generic-frame character separation proves multiplication injective on
finite sums of homogeneous sections. The hypothesis is generic nonvanishing
of the homogeneous multiplier, not regularity of that multiplier. -/
theorem nativeGradedSection_mul_eq_zero_imp_eq_zero
    {I K R Z : Type} [Fintype I] [DecidableEq I]
    [Field K] [CommRing R] [Algebra K R]
    (W : (I → ℤ) → Submodule K R)
    (F : Z → Type) [∀ z, Field (F z)] [∀ z, CharZero (F z)]
    (generic : ∀ z, R →+* F z)
    (frame : ∀ z, (I → (F z)ˣ) → R →+* F z)
    (hweight : ∀ z e f, f ∈ W e → ∀ t,
      frame z t f = nativeWeightTorusCharacter (F z) e t * generic z f)
    (hfaithful : ∀ e f, f ∈ W e → (∀ z, generic z f = 0) → f = 0)
    (e : I → ℤ) (u : R) (hu : u ∈ W e)
    (hgeneric : ∀ z, generic z u ≠ 0)
    (f : R) (hf : f ∈ ⨆ d, W d) (huf : u * f = 0) : f = 0 := by
  classical
  obtain ⟨a, ha, rfl⟩ := (Submodule.mem_iSup_iff_exists_finsupp _ f).1 hf
  have hcomponent : ∀ z, ∀ d ∈ a.support, generic z (a d) = 0 := by
    intro z
    have hli : LinearIndependent (F z)
        (fun d => (nativeWeightTorusCharacter (F z) d : (I → (F z)ˣ) → F z)) :=
      (linearIndependent_monoidHom _ (F z)).comp
        (nativeWeightTorusCharacter (F z)) (nativeWeightTorusCharacter_injective (F z))
    have hsum : ∑ d ∈ a.support,
        generic z (a d) •
          (nativeWeightTorusCharacter (F z) d : (I → (F z)ˣ) → F z) = 0 := by
      funext t
      have hu0 : frame z t u ≠ 0 := by
        rw [hweight z e u hu]
        exact mul_ne_zero (Units.ne_zero _) (hgeneric z)
      have h1 : frame z t (u * a.sum fun _ x => x) = 0 := by
        rw [huf, map_zero]
      rw [map_mul] at h1
      have h2 : frame z t (a.sum fun _ x => x) = 0 :=
        (mul_eq_zero.1 h1).resolve_left hu0
      simp only [Finsupp.sum, map_sum] at h2
      simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Pi.zero_apply]
      rw [← h2]
      refine Finset.sum_congr rfl fun d _ => ?_
      rw [hweight z d (a d) (ha d), mul_comm]
    intro d hd
    exact linearIndependent_iff'.1 hli a.support (fun d => generic z (a d)) hsum d hd
  exact Finset.sum_eq_zero fun d hd => hfaithful d (a d) (ha d) fun z => hcomponent z d hd

/-- Package the preceding supplying proof as actual regularity in the
constructed section algebra, preserving the original restriction of domain. -/
theorem nativeGradedSection_regular
    {I K R Z : Type} [Fintype I] [DecidableEq I]
    [Field K] [CommRing R] [Algebra K R]
    (W : (I → ℤ) → Submodule K R)
    (hone : (1 : R) ∈ W 0)
    (hprod : ∀ e e', W e * W e' ≤ W (e + e'))
    (F : Z → Type) [∀ z, Field (F z)] [∀ z, CharZero (F z)]
    (generic : ∀ z, R →+* F z)
    (frame : ∀ z, (I → (F z)ˣ) → R →+* F z)
    (hweight : ∀ z e f, f ∈ W e → ∀ t,
      frame z t f = nativeWeightTorusCharacter (F z) e t * generic z f)
    (hfaithful : ∀ e f, f ∈ W e → (∀ z, generic z f = 0) → f = 0)
    (e : I → ℤ) (u : nativeGradedSectionAlgebra W hone hprod)
    (hu : (u : R) ∈ W e) (hgeneric : ∀ z, generic z u ≠ 0) :
    u ∈ nonZeroDivisors (nativeGradedSectionAlgebra W hone hprod) := by
  have hleft : ∀ f : nativeGradedSectionAlgebra W hone hprod, u * f = 0 → f = 0 := by
    intro f hf
    apply Subtype.ext
    exact nativeGradedSection_mul_eq_zero_imp_eq_zero W F generic frame hweight hfaithful
      e u hu hgeneric f f.2 (congrArg Subtype.val hf)
  rw [mem_nonZeroDivisors_iff]
  exact ⟨hleft, fun f hf => hleft f (by rwa [mul_comm])⟩


/-- A weight-preserving ambient action restricts to the constructed section
algebra. This is the original `pullSec` construction. -/
def nativeGradedSectionAction
    {I K R H : Type} [Field K] [CommRing R] [Algebra K R]
    (W : (I → ℤ) → Submodule K R)
    (hone : (1 : R) ∈ W 0)
    (hprod : ∀ e e', W e * W e' ≤ W (e + e'))
    (st : H → R →ₐ[K] R)
    (hst : ∀ h e f, f ∈ W e → st h f ∈ W e)
    (h : H) : nativeGradedSectionAlgebra W hone hprod →ₐ[K]
      nativeGradedSectionAlgebra W hone hprod :=
  ((st h).comp (nativeGradedSectionAlgebra W hone hprod).val).codRestrict _ fun f => by
    have hle : (⨆ e, W e) ≤ (⨆ e, W e).comap (st h).toLinearMap :=
      iSup_le fun e g hg => Submodule.mem_iSup_of_mem e (hst h e g hg)
    exact hle f.2

/-- A determinant of same-weight entries has the actual cardinality multiple
of that weight, exactly as `levDet_mem_secZ` in the source. -/
theorem nativeGradedSection_det_mem
    {I K R H : Type} [Field K] [CommRing R] [Algebra K R]
    [Fintype H] [DecidableEq H]
    (W : (I → ℤ) → Submodule K R)
    (hone : (1 : R) ∈ W 0)
    (hprod : ∀ e e', W e * W e' ≤ W (e + e'))
    (e : I → ℤ) (M : Matrix H H R) (hM : ∀ h g, M h g ∈ W e) :
    M.det ∈ W (Fintype.card H • e) := by
  classical
  have hProd : ∀ (s : Finset H) (f : H → R),
      (∀ h, f h ∈ W e) → ∏ h ∈ s, f h ∈ W (s.card • e) := by
    intro s f hf
    induction s using Finset.cons_induction with
    | empty => simpa using hone
    | cons a s ha ih =>
      rw [Finset.prod_cons, Finset.card_cons, succ_nsmul']
      exact hprod _ _ (Submodule.mul_mem_mul (hf a) ih)
  rw [Matrix.det_apply]
  refine Submodule.sum_mem _ fun σ _ => ?_
  rw [Units.smul_def]
  exact zsmul_mem (hProd Finset.univ _ fun h => hM _ h) _

/-- The actual component generic determinants supply a regular determinant
in the section algebra. This bridges to the native twisted-trace theorem
without assuming regularity among all ambient rules. -/
theorem nativeGradedSection_groupDet_regular
    {I K R Z H : Type} [Fintype I] [DecidableEq I]
    [Field K] [CommRing R] [Algebra K R]
    [Group H] [Fintype H] [DecidableEq H]
    (W : (I → ℤ) → Submodule K R)
    (hone : (1 : R) ∈ W 0)
    (hprod : ∀ e e', W e * W e' ≤ W (e + e'))
    (F : Z → Type) [∀ z, Field (F z)] [∀ z, CharZero (F z)]
    (generic : ∀ z, R →+* F z)
    (frame : ∀ z, (I → (F z)ˣ) → R →+* F z)
    (hweight : ∀ z e f, f ∈ W e → ∀ t,
      frame z t f = nativeWeightTorusCharacter (F z) e t * generic z f)
    (hfaithful : ∀ e f, f ∈ W e → (∀ z, generic z f = 0) → f = 0)
    (st : H → R →ₐ[K] R)
    (hst : ∀ h e f, f ∈ W e → st h f ∈ W e)
    (e : I → ℤ) (u : nativeGradedSectionAlgebra W hone hprod)
    (hu : (u : R) ∈ W e)
    (hdet : ∀ z, (Matrix.of fun h g : H => generic z (st (h * g) u)).det ≠ 0) :
    (Matrix.of fun h g : H =>
      nativeGradedSectionAction W hone hprod st hst (h * g) u).det ∈
      nonZeroDivisors (nativeGradedSectionAlgebra W hone hprod) := by
  let A := nativeGradedSectionAlgebra W hone hprod
  let M : Matrix H H A := Matrix.of fun h g =>
    nativeGradedSectionAction W hone hprod st hst (h * g) u
  have hcoe : (M.det : R) = (Matrix.of fun h g : H => st (h * g) u).det := by
    have h := A.val.toRingHom.map_det M
    convert h using 2 <;> rfl
  apply nativeGradedSection_regular W hone hprod F generic frame hweight hfaithful
    (Fintype.card H • e) M.det
  · rw [hcoe]
    exact nativeGradedSection_det_mem W hone hprod e _ fun h g => hst (h * g) e u hu
  · intro z
    rw [hcoe, RingHom.map_det, RingHom.mapMatrix_apply]
    exact hdet z

end RHLean.Geometry
