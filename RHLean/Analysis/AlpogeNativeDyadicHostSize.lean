import RHLean.Analysis.AlpogeNativeReciprocitySurjective

/-!
# Exact size of the constructed dyadic arithmetic host

The host is the actual group of units modulo `2^(e+2)`, divided by the
two-element subgroup generated by `-1`. Its cardinality is proved from
Lagrange's theorem and Euler's totient formula. Thus the host size appearing
in the character counts and the physical modulus are tied to the same
dyadic exponent, rather than being independently chosen size parameters.

These are exact finite arithmetic identities. They do not bound the
geometric top excess or assert that the final normalized thin bill is small.
-/

set_option autoImplicit false

noncomputable section

namespace RHLean.Analysis

/-- The full dyadic unit quotient has exactly `2^e` elements. -/
theorem alpogeNativeDyadicH_card (e : ℕ) :
    Fintype.card (AlpogeNativeDyadicH e) = 2 ^ e := by
  have hlarge : 2 < 2 ^ (e + 2) := by
    have hp : 0 < 2 ^ e := pow_pos (by decide) e
    rw [pow_add]
    norm_num
    omega
  let : Fact (2 < 2 ^ (e + 2)) := ⟨hlarge⟩
  have hne : (-1 : (ZMod (2 ^ (e + 2)))ˣ) ≠ 1 := by
    intro h
    apply ZMod.neg_one_ne_one (n := 2 ^ (e + 2))
    simpa only [Units.val_neg, Units.val_one] using congrArg Units.val h
  have horder : orderOf (-1 : (ZMod (2 ^ (e + 2)))ˣ) = 2 :=
    orderOf_eq_prime (by simp) hne
  have hsign : Nat.card (Subgroup.zpowers (-1 : (ZMod (2 ^ (e + 2)))ˣ)) = 2 := by
    rw [Nat.card_zpowers, horder]
  have hunits : Nat.card ((ZMod (2 ^ (e + 2)))ˣ) = 2 ^ (e + 1) := by
    rw [Nat.card_eq_fintype_card, ZMod.card_units_eq_totient]
    simpa using Nat.totient_prime_pow_succ Nat.prime_two (e + 1)
  have hindex := (Subgroup.zpowers (-1 : (ZMod (2 ^ (e + 2)))ˣ)).card_eq_card_quotient_mul_card_subgroup
  rw [hunits, hsign, pow_succ] at hindex
  rw [Fintype.card_eq_nat_card]
  change Nat.card (((ZMod (2 ^ (e + 2)))ˣ) ⧸
    Subgroup.zpowers (-1 : (ZMod (2 ^ (e + 2)))ˣ)) = 2 ^ e
  omega

/-- The same host cardinality fixes the actual conductor modulus. -/
theorem alpogeNativeHostN_eq_four_card_mul (e q d : ℕ) :
    alpogeNativeHostN e q d =
      4 * Fintype.card (AlpogeNativeDyadicH e) * q * d := by
  simp only [alpogeNativeHostN, alpogeNativeDyadicH_card, pow_add]
  ring

/-- Exact conductor accounting for the size condition in the selected-pair
thin theorem. Positivity is supplied by the actual prime factors. -/
theorem alpogeNativeHostN_log (e q d : ℕ) (hq : 0 < q) (hd : 0 < d) :
    Real.log (alpogeNativeHostN e q d : ℝ) =
      ((e : ℝ) + 2) * Real.log 2 + Real.log q + Real.log d := by
  have hq0 : (q : ℝ) ≠ 0 := by exact_mod_cast hq.ne'
  have hd0 : (d : ℝ) ≠ 0 := by exact_mod_cast hd.ne'
  have h20 : (2 : ℝ) ^ (e + 2) ≠ 0 := pow_ne_zero _ (by norm_num)
  simp only [alpogeNativeHostN, Nat.cast_mul, Nat.cast_pow, Nat.cast_ofNat]
  rw [Real.log_mul (mul_ne_zero h20 hq0) hd0,
    Real.log_mul h20 hq0, Real.log_pow]
  push_cast

end RHLean.Analysis

end
