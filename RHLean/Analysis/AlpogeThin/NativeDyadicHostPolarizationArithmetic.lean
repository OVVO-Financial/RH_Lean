import RHLean.Analysis.AlpogeNativeQuadraticDifferent
import RHLean.Analysis.AlpogeThin.NativeDyadicHostDifferent

/-!
# The principal polarization ideal identity on the actual native field

The quadratic subfield is literally `HostRaw.K = ℚ(sqrt(-d))`. Its different
is proved to be generated by the same square root, then the tower formula
combines it with the constructed conjugate half of the relative different.
For the original host constructor's choice `ccK = ⊤`, this gives exactly
the principal-datum ideal identity with `xi = -1 / sqrt(-d)` and `AA = B⁻¹`.
The same identity proves integrality of the resulting trace products.

This constructs the arithmetic polarization data, not the full geometric
`Datum`: the prescribed Hermitian spaces, their integral base lattices and
their real signature and finite-place compatibilities remain separate data.

Mathematical source: Levent Alpöge (with Claude),
`CocoSgt/riemann-hypothesis-lean@7cbf7a0c32fca1badf05931879a37c3f8a2b03b4`,
`src/Formalism/SharpRestriction/GlobalSchurBounds/GlobalRankLatticeProofs/`
`EqOfLeOfAbsNormEq.lean`, `HK.{gen_top,diffK_holds}`;
`src/Formalism/LocalRingCardinality/RankBoundMonotoneInDimension.lean`,
`factPrincipalDatum_of`; and
`src/Formalism/LocalToGlobal/ProjectiveLattices/HostInt.lean`,
`trace_int_of_mem`. The choice `ccK = ⊤` is the one explicitly constructed
by `src/Development/AutomorphicArithmetic/PrimeDiscriminants/ExistsHost.lean`,
`UpperTheory.Host.exists_host_of_injective`.
The source archive/mirror states no license; attribution is retained
without assigning a new license to source-derived material.
-/

set_option autoImplicit false
set_option maxHeartbeats 4000000

noncomputable section

open NumberField IntermediateField Ideal FractionalIdeal
open scoped Pointwise nonZeroDivisors

namespace RHLean.Analysis.AlpogeThin

open Formalism.HC Formalism.FrobeniusOrbits

namespace NativeRawHostPolarization

variable {φ : Frame} (H : HostRaw φ)

/-- The original root as an element of the literal quadratic subfield. -/
def sqdK : H.K := ⟨H.sqd, NativeRawHostDifferent.sqd_mem_K H⟩

theorem sqdK_sq : sqdK H ^ 2 = -(H.d : H.K) := by
  apply Subtype.ext
  simpa [sqdK] using H.sqd_sq

theorem sqdK_integral : IsIntegral ℤ (sqdK H) := by
  refine ⟨Polynomial.X ^ 2 + Polynomial.C (H.d : ℤ),
    Polynomial.monic_X_pow_add_C _ two_ne_zero, ?_⟩
  rw [Polynomial.eval₂_add, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, sqdK_sq]
  simp

def sqdIntK : 𝓞 H.K := ⟨sqdK H, sqdK_integral H⟩

theorem sqdK_adjoin_top : IntermediateField.adjoin ℚ {sqdK H} = ⊤ := by
  apply IntermediateField.map_injective (IsScalarTower.toAlgHom ℚ H.K H.E)
  rw [IntermediateField.adjoin_map, Set.image_singleton, ← AlgHom.fieldRange_eq_map]
  ext z
  rw [AlgHom.mem_fieldRange]
  change z ∈ IntermediateField.adjoin ℚ {H.sqd} ↔
    ∃ y : H.K, (y : H.E) = z
  constructor
  · intro hz
    exact ⟨⟨z, hz⟩, rfl⟩
  · rintro ⟨y, rfl⟩
    exact y.2

theorem neg_d_squarefree : Squarefree (-(H.d : ℤ)) := by
  apply Int.squarefree_natAbs.mp
  simpa only [Int.natAbs_neg, Int.natAbs_natCast] using
    ((Nat.irreducible_iff_nat_prime H.d).mpr H.hyp.2.1).squarefree

theorem neg_d_mod_four : -(H.d : ℤ) % 4 = 1 := by
  have hd16 := H.hyp.2.2.2.1
  omega

theorem quadratic_discr : NumberField.discr H.K = -(H.d : ℤ) :=
  NativeQuadraticDifferent.discr_eq H.K (-(H.d : ℤ)) (sqdK H)
    (by rw [sqdK_sq]; simp) (sqdK_adjoin_top H) (neg_d_squarefree H)
    (neg_d_mod_four H) (by omega)

theorem quadratic_different : differentIdeal ℤ (𝓞 H.K) = Ideal.span {sqdIntK H} :=
  NativeQuadraticDifferent.different_eq_span_root H.K (-(H.d : ℤ)) (sqdK H)
    (by rw [sqdK_sq]; simp) (sqdK_adjoin_top H) (neg_d_squarefree H)
    (neg_d_mod_four H) (by omega) (sqdIntK H) rfl

theorem mapped_quadratic_different :
    (((differentIdeal ℤ (𝓞 H.K)).map (algebraMap (𝓞 H.K) (𝓞 H.E)) :
      Ideal (𝓞 H.E)) : FractionalIdeal (𝓞 H.E)⁰ H.E) =
        spanSingleton (𝓞 H.E)⁰ H.sqd := by
  simp only [quadratic_different, Ideal.map_span, Set.image_singleton,
    coeIdeal_span_singleton]

/-- The original imaginary generator for the constructed choice `ccK = ⊤`. -/
def xi : H.E := -1 / H.sqd

theorem xi_ne_zero : xi H ≠ 0 :=
  div_ne_zero (neg_ne_zero.mpr one_ne_zero) (NativeRawHostCore.sqd_ne_zero H)

theorem conj_sqd : H.conj H.sqd = -H.sqd := by
  rw [H.gal_sqd, NativeRawHostDifferent.gal_conj]
  simp [Frame.cc, c0]

theorem conj_xi : H.conj (xi H) = -xi H := by
  simp only [xi, map_div₀, map_neg, map_one, conj_sqd, div_neg]

/-- Positivity uses the exact source CM type, not a newly chosen half-type. -/
theorem xi_im_pos (ψ : H.E →+* ℂ) (hψ : ψ ∈ H.cmType) :
    0 < (ψ (xi H)).im := by
  have hpos : 0 < Real.sqrt (H.d : ℝ) :=
    Real.sqrt_pos.mpr (by exact_mod_cast H.hyp.2.1.pos)
  have hne : (Real.sqrt (H.d : ℝ) : ℂ) ≠ 0 := by exact_mod_cast hpos.ne'
  have hval : ψ (xi H) = Complex.I * (Real.sqrt (H.d : ℝ) : ℂ)⁻¹ := by
    rw [xi, map_div₀, map_neg, map_one, show ψ H.sqd =
      Complex.I * (Real.sqrt (H.d : ℝ) : ℂ) from hψ]
    apply (div_eq_iff (mul_ne_zero Complex.I_ne_zero hne)).mpr
    rw [mul_mul_mul_comm, Complex.I_mul_I, inv_mul_cancel₀ hne, mul_one]
  rw [hval, ← Complex.ofReal_inv]
  simpa only [Complex.mul_im, Complex.I_re, Complex.I_im, Complex.ofReal_re,
    Complex.ofReal_im, zero_mul, one_mul, zero_add] using inv_pos.mpr hpos

attribute [local instance] FractionRing.liftAlgebra FractionRing.isScalarTower_liftAlgebra

theorem halfDifferent_ne_zero (B : Ideal (𝓞 H.E))
    (hB : differentIdeal (𝓞 H.K) (𝓞 H.E) = B * (H.conj • B)) :
    (B : FractionalIdeal (𝓞 H.E)⁰ H.E) ≠ 0 ∧
      ((H.conj • B : Ideal (𝓞 H.E)) : FractionalIdeal (𝓞 H.E)⁰ H.E) ≠ 0 := by
  have hne : differentIdeal (𝓞 H.K) (𝓞 H.E) ≠ ⊥ := differentIdeal_ne_bot
  rw [hB] at hne
  constructor
  · rw [Ne, coeIdeal_eq_zero]
    intro h
    exact hne (by rw [h]; simp)
  · rw [Ne, coeIdeal_eq_zero]
    intro h
    exact hne (by rw [h]; simp)

/-- The source `FactPrincipalDatum` equality at its actual `ccK = ⊤`
choice. The native endpoint below constructs the half-different witness. -/
theorem principalIdentity (B : Ideal (𝓞 H.E))
    (hB : differentIdeal (𝓞 H.K) (𝓞 H.E) = B * (H.conj • B)) :
    spanSingleton (𝓞 H.E)⁰ (xi H) *
        (B : FractionalIdeal (𝓞 H.E)⁰ H.E)⁻¹ *
        ((H.conj • B : Ideal (𝓞 H.E)) : FractionalIdeal (𝓞 H.E)⁰ H.E)⁻¹ *
        (differentIdeal ℤ (𝓞 H.E) : FractionalIdeal (𝓞 H.E)⁰ H.E) = 1 := by
  have ht := differentIdeal_eq_differentIdeal_mul_differentIdeal ℤ (𝓞 H.K) (𝓞 H.E)
  obtain ⟨hB0, hbarB0⟩ := halfDifferent_ne_zero H B hB
  rw [ht, hB, coeIdeal_mul, coeIdeal_mul, mapped_quadratic_different]
  have hcalc : ∀ s B B' D : FractionalIdeal (𝓞 H.E)⁰ H.E,
      s * B⁻¹ * B'⁻¹ * (B * B' * D) = s * D * (B⁻¹ * B) * (B'⁻¹ * B') := by
    intro s B B' D
    ring
  rw [hcalc, inv_mul_cancel₀ hB0, inv_mul_cancel₀ hbarB0, mul_one, mul_one,
    spanSingleton_mul_spanSingleton]
  have hval : xi H * H.sqd = -1 :=
    div_mul_cancel₀ _ (NativeRawHostCore.sqd_ne_zero H)
  rw [hval, ← spanSingleton_one, spanSingleton_eq_spanSingleton]
  exact ⟨-1, by simp⟩

theorem trace_integral_of_mem (B : Ideal (𝓞 H.E))
    (hB : differentIdeal (𝓞 H.K) (𝓞 H.E) = B * (H.conj • B))
    {z : H.E} (hz : z ∈ (B : FractionalIdeal (𝓞 H.E)⁰ H.E)⁻¹ *
      ((H.conj • B : Ideal (𝓞 H.E)) : FractionalIdeal (𝓞 H.E)⁰ H.E)⁻¹) :
    ∃ n : ℤ, Algebra.trace ℚ H.E (xi H * z) = n := by
  have hJ : spanSingleton (𝓞 H.E)⁰ (xi H) *
      (B : FractionalIdeal (𝓞 H.E)⁰ H.E)⁻¹ *
      ((H.conj • B : Ideal (𝓞 H.E)) : FractionalIdeal (𝓞 H.E)⁰ H.E)⁻¹ =
      FractionalIdeal.dual ℤ ℚ (1 : FractionalIdeal (𝓞 H.E)⁰ H.E) := by
    rw [eq_inv_of_mul_eq_one_left (principalIdentity H B hB),
      coeIdeal_differentIdeal ℤ ℚ H.E (𝓞 H.E), inv_inv]
  have hm : xi H * z ∈ spanSingleton (𝓞 H.E)⁰ (xi H) *
      (B : FractionalIdeal (𝓞 H.E)⁰ H.E)⁻¹ *
      ((H.conj • B : Ideal (𝓞 H.E)) : FractionalIdeal (𝓞 H.E)⁰ H.E)⁻¹ := by
    rw [mul_assoc]
    exact mul_mem_mul (mem_spanSingleton_self _ _) hz
  rw [hJ, mem_dual (one_ne_zero : (1 : FractionalIdeal (𝓞 H.E)⁰ H.E) ≠ 0)] at hm
  obtain ⟨n, hn⟩ := hm 1 (one_mem_one _)
  refine ⟨n, ?_⟩
  rw [Algebra.traceForm_apply, mul_one] at hn
  rw [← hn]
  simp

end NativeRawHostPolarization

/-- One actually constructed ideal supplies the original half-different
conditions and the principal polarization identity on the same native host. -/
theorem nativeDyadicHostRaw_exists_principalPolarizationArithmetic
    (e q d : ℕ) [Fact q.Prime] [Fact d.Prime]
    (he : 2 ≤ e) (hH : HostHyp q d) :
    let H := nativeDyadicHostRaw e q d he hH
    ∃ B : Ideal (𝓞 H.E),
      differentIdeal (𝓞 H.K) (𝓞 H.E) = B * (H.conj • B) ∧
      B ⊔ H.conj • B = ⊤ ∧
      (∀ σ : H.E ≃ₐ[ℚ] H.E, H.gal σ ∈ (nativeDyadicFrame e).Psi → σ • B = B) ∧
      spanSingleton (𝓞 H.E)⁰ (NativeRawHostPolarization.xi H) *
        (B : FractionalIdeal (𝓞 H.E)⁰ H.E)⁻¹ *
        ((H.conj • B : Ideal (𝓞 H.E)) : FractionalIdeal (𝓞 H.E)⁰ H.E)⁻¹ *
        (differentIdeal ℤ (𝓞 H.E) : FractionalIdeal (𝓞 H.E)⁰ H.E) = 1 := by
  let H := nativeDyadicHostRaw e q d he hH
  obtain ⟨B, hB, hcop, hinv⟩ := nativeDyadicHostRaw_principal e q d he hH
  exact ⟨B, hB, hcop, hinv, NativeRawHostPolarization.principalIdentity H B hB⟩

end RHLean.Analysis.AlpogeThin

end
